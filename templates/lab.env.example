# 실습 환경 값. 두 container 모두 <workspace>/work/lab.env 로 복사해 code 로 한 번 채운다(00-08·00-12).
#   개발용: ~/commerce-platform/work/lab.env   관리용: ~/commerce-admin/work/lab.env (같은 내용 그대로 복사)
# 새 터미널을 열면 image 의 lab-shell.sh 가 이 파일을 읽어 export 한다. 교안 블록마다 source 하지 않는다.
# 이 파일에는 Account ID·App ID 같은 식별자만 둔다. 민감한 값(token, private key 내용)은 넣지 않는다.
# 뒤에 줄을 덧붙이지 않는다(cat >>·echo >> 금지). Git 에 들어갈 값은 Git 파일에, 바뀌는 값은 SSM Parameter 에 있다.
# 경로는 COMMERCE_WORKSPACE(devcontainer.json remoteEnv) 기준이라 두 container 에서 고치지 않고 그대로 쓴다.

# ---------- repository 위치 ----------
INFRA_ROOT="$COMMERCE_WORKSPACE/cloud-platform-infrastructure"
API_ROOT="$COMMERCE_WORKSPACE/commerce-api"
WEB_ROOT="$COMMERCE_WORKSPACE/commerce-web"
PLAYBOOKS_ROOT="$COMMERCE_WORKSPACE/commerce-robusta-playbooks"
# 완성 코드(과정 zip 의 code/ 폴더를 work/solution 에 복사한 위치)
SOLUTION_CODE="$COMMERCE_WORKSPACE/work/solution"
SOLUTION_INFRA="$SOLUTION_CODE/cloud-platform-infrastructure"

# ---------- GitHub ----------
# 수강생용 Organization. 예: minsu-commerce-lab
GITHUB_ORG="<수강생용 GitHub 조직>"
# PR 작성자와 승인자 GitHub login(00-06). 예: minsu-dev / jiwoo-lab
AUTHOR_GITHUB_LOGIN="<작성자 GitHub login>"
APPROVER_GITHUB_LOGIN="<승인자 GitHub login>"
# 02-05 GitHub stack 첫 로컬 apply(make bootstrap ACCOUNT=github)에만 쓰는 쓰기 App 값(scripts/ops/bootstrap.sh가 읽음).
# 그 밖의 App ID는 여기 적지 않는다. 원본은 GitHub stack의 terraform.tfvars(github_apps)다.
# App ID 예: 1234567(App 화면 General → App ID), installation ID 예: 87654321
SETTINGS_WRITER_APP_ID="<commerce-github-settings-writer App ID>"
# pem 은 browser 에서 받은 key 파일 위치. apply 뒤 gh secret set 으로 넣고 바로 지운다.
SETTINGS_WRITER_INSTALLATION_ID="<writer App installation ID>"
SETTINGS_WRITER_PEM_FILE="$COMMERCE_WORKSPACE/work/github-settings-writer.pem"

# ---------- 도메인 ----------
# 끝의 점과 https:// 없이. 예: example.com
PARENT_DOMAIN="<상위 도메인>"

# ---------- AWS Account ID(00-09) ----------
MANAGEMENT_ACCOUNT_ID="<Management Account ID>"
NETWORK_ACCOUNT_ID="<Network Account ID>"
DEV_ACCOUNT_ID="<Dev Account ID>"
PROD_ACCOUNT_ID="<Prod Account ID>"
SECURITY_ACCOUNT_ID="<Security Tooling Account ID>"
LOG_ARCHIVE_ACCOUNT_ID="<Log Archive Account ID>"
BACKUP_ACCOUNT_ID="<Backup Account ID>"

# ---------- ECR ----------
# 예: 111111111111.dkr.ecr.ap-northeast-2.amazonaws.com
ECR_REGISTRY_DEV="$DEV_ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com"
ECR_REGISTRY_PROD="$PROD_ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com"

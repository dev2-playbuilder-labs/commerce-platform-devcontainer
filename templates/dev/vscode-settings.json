// 개발용 컨테이너 창의 색 구분. 평소 작업 창은 초록색으로 구분한다.
// 호스트 작업 폴더의 .vscode/settings.json으로 복사한다. 컨테이너를 다시 빌드하지 않아도 바로 적용된다.
{
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#14532d",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#0f3d22",
    "titleBar.inactiveForeground": "#e5e5e5",
    "statusBar.background": "#166534",
    "statusBar.foreground": "#ffffff",
    "terminal.background": "#0c1a12"
  },
  // 창 제목 앞에 역할을 붙여 여러 창을 띄워도 구분한다.
  "window.title": "[DEV] ${rootName}${separator}${activeEditorShort}"
}
